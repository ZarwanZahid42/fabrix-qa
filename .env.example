# FabriX-QA local configuration template.
# Copy to .env, replace every CHANGE_ME value, and never commit the result.

# Application
APP_NAME=FabriX-QA
APP_ENV=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# JWT and RBAC
JWT_SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fabrix_qa
POSTGRES_USER=fabrix
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_URL=postgresql+asyncpg://fabrix:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/fabrix_qa

# MongoDB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=fabrix
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGO_DB_NAME=fabrix_qa_media
MONGO_URL=mongodb://fabrix:CHANGE_ME_MONGO_PASSWORD@mongo:27017/fabrix_qa_media?authSource=admin

# Twilio SMS
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=CHANGE_ME_E164_SENDER_NUMBER
ALERT_SMS_RECIPIENTS=CHANGE_ME_COMMA_SEPARATED_E164_NUMBERS

# Email / FastAPI-Mail SMTP
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM=CHANGE_ME_SENDER_EMAIL
MAIL_FROM_NAME=FabriX-QA
MAIL_SERVER=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
ALERT_EMAIL_RECIPIENTS=CHANGE_ME_COMMA_SEPARATED_EMAILS

# Browser-visible frontend endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# AI model artifacts and thresholds
YOLO_MODEL_PATH=ai/models/yolov8_fabric_defects.pt
CNN_CLASSIFIER_MODEL_PATH=ai/models/fabric_defect_classifier.pt
AUTOENCODER_MODEL_PATH=ai/models/fabric_anomaly_autoencoder.pt
DETECTION_CONFIDENCE_THRESHOLD=0.50
DETECTION_IOU_THRESHOLD=0.45
ANOMALY_THRESHOLD=CHANGE_ME_AFTER_MODEL_CALIBRATION
DEVICE=cpu

# Edge capture and physical measurement
CAMERA_SOURCE=0
CAMERA_FPS=25
FRAME_WIDTH=1920
FRAME_HEIGHT=1080
ROI_CONFIG_PATH=edge/roi_config.json
FABRIC_WIDTH_METERS=CHANGE_ME_FACTORY_VALUE
LINE_SPEED_METERS_PER_MINUTE=CHANGE_ME_FACTORY_VALUE

# Four-point grading and alert policy (confirm with domain expert before use)
MAX_POINTS_PER_DEFECT=4
GRADE_A_MAX_POINTS_PER_100_SQ_YD=CHANGE_ME
GRADE_B_MAX_POINTS_PER_100_SQ_YD=CHANGE_ME
GRADE_C_MAX_POINTS_PER_100_SQ_YD=CHANGE_ME
ALERT_POINTS_THRESHOLD=CHANGE_ME
ALERT_CRITICAL_DEFECT_TYPES=hole
