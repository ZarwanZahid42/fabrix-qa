# ============================================================
# FabriX-QA — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
DEBUG=true

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fabrixdb
POSTGRES_USER=fabrix
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_URL=postgresql+asyncpg://fabrix:your-postgres-password@localhost:5432/fabrixdb

# ── MongoDB ───────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=fabrix
MONGO_PASSWORD=your-mongo-password
MONGO_DB_NAME=fabrix_defects
MONGO_URL=mongodb://fabrix:your-mongo-password@localhost:27017

# ── Redis (Celery Broker) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Twilio (SMS Alerts) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
ALERT_SMS_RECIPIENTS=+60123456789,+60129876543   # Comma-separated recipient numbers

# ── Email / SMTP (FastAPI-Mail) ───────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@fabrixqa.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true
ALERT_EMAIL_RECIPIENTS=supervisor@factory.com,manager@factory.com

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── AI / Inference ────────────────────────────────────────────
YOLO_MODEL_PATH=ai/models/fabrix_yolo_best.pt
CLASSIFIER_MODEL_PATH=ai/models/fabrix_classifier_best.pth
INFERENCE_CONFIDENCE_THRESHOLD=0.45
INFERENCE_IOU_THRESHOLD=0.50

# ── Camera / Stream ───────────────────────────────────────────
CAMERA_SOURCE=0                          # 0 = local webcam, or RTSP URL
CAMERA_FPS=25
ROI_CONFIG_PATH=edge/roi_config.json

# ── MLflow (Experiment Tracking) ──────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fabrix-qa-defect-detection
